      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *protection*)",
      "Bash(gh api -X PATCH repos/appleboblin/dotfiles-nixos*)",
      "Bash(gh api --method PATCH repos/appleboblin/dotfiles-nixos*)",
      "Bash(gh repo edit*)",
      "Bash(gh ruleset *)"
    ]
  }
}
